## Frontend
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web security / cross-origin
# - For local dev over HTTP keep COOKIE_SECURE=false.
# - In production behind HTTPS set COOKIE_SECURE=true.
COOKIE_SECURE=false

# Comma-separated list of allowed origins.
CORS_ALLOW_ORIGINS=http://localhost:3000

## Backend
APP_ENV=dev
DATABASE_URL=postgresql://postgres:postgres@db:5432/ask_piotr
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536
ROUTER_MODEL=gpt-4.1-mini
SYNTHESIS_MODEL=gpt-4o-mini
SYNTHESIS_TEMPERATURE=0.1
PROMPT_CACHE_ENABLED=true
OPENAI_API_KEY=sk-...

# OpenAI client behavior (defaults are safe for local dev)
OPENAI_TIMEOUT_S=60
OPENAI_MAX_RETRIES=2

# Startup automation (backend container entrypoint)
# - If enabled, backend will apply SQL migrations and ensure the knowledge base is ingested
#   on every container start.
AUTO_MIGRATE_ENABLED=true
AUTO_INGEST_ENABLED=true
# If true, backend will refuse to start if migrate/ingest fails.
AUTO_STARTUP_FAIL_FAST=true

# Database (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ask_piotr
PGDATA=/var/lib/postgresql/data/pgdata

# Retrieval
# - Controls max number of chunks returned from a single card during the capped
#   diversification passes.
RETRIEVAL_PER_CARD_CAP=2

# Retrieval cutoffs (cosine distance)
# - Lower distance = more similar.
# - Set to "off" to disable.
RETRIEVAL_MAX_DISTANCE=0.90
RETRIEVAL_DISTANCE_DELTA=0.40

# Multi-category routing + per-category retrieval (flag-gated)
#
# When enabled, routing runs on the original user question and returns multiple
# categories with per-category budgets. Retrieval is then performed per category
# and merged/deduped with coverage-aware capping.
MULTI_CATEGORY_RETRIEVAL_ENABLED=true
# Stable request-id based rollout (0-100). Effective only when enabled.
MULTI_CATEGORY_ROLLOUT_PERCENT=100
MULTI_CATEGORY_MAX_CATEGORIES=2
MULTI_CATEGORY_MAX_TOTAL_CHUNKS=5
MULTI_CATEGORY_ALLOW_SIX_CHUNKS=false
# Budget policy version. Currently only "deterministic" is supported.
MULTI_CATEGORY_BUDGET_POLICY=deterministic

# Multi-category pinning rules (JSON format)
# - Ensures specific cards are always included when certain routing categories are routed.
# - JSON keys are RoutingCategory values (snake_case), NOT CardCategory values.
# - Map RoutingCategory values to lists of card IDs to pin.
MULTI_CATEGORY_PINNING_RULES={"education_and_formal_background": ["education-facts"], "research_and_academic_credibility": ["research-overview", "research-key-publications"], "leadership_and_product_strategy": ["experience-leadership-and-ways-of-working", "leadership-agile"], "hands_on_engineering": ["skills-core", "skills-programming-languages"], "architecture_and_system_design": ["experience-architecture-boundaries-and-multiservice"], "ai_and_ml_practice": ["experience-ai-evaluation-and-cost-control"], "career_fit_and_role_alignment": ["profile-identity", "profile-professional-summary"], "personal_interests_and_working_style": ["personal-interests", "personal-location-citizenship"]}

# Multi-category section weights (JSON format)
# - Boosts specific sections during retrieval for certain routing categories.
# - JSON keys are RoutingCategory values (snake_case), NOT CardCategory values.
# - Weights are positive values that BOOST section ranking (subtract from distance).
# - Formula: adjusted_distance = distance + penalty - bonus
# - Maximum bonus is capped at 0.25 to prevent weak chunks from jumping strong ones.
MULTI_CATEGORY_SECTION_WEIGHTS={"education_and_formal_background": {"What I built": 0.20}, "research_and_academic_credibility": {"What I built": 0.15}, "leadership_and_product_strategy": {"What I built": 0.12, "Scale and impact": 0.10}, "hands_on_engineering": {"What I built": 0.15, "Tech stack": 0.12}, "architecture_and_system_design": {"What I built": 0.15, "Key decisions and trade-offs": 0.10}, "ai_and_ml_practice": {"What I built": 0.15, "Scale and impact": 0.12}, "career_fit_and_role_alignment": {"What I built": 0.12}, "personal_interests_and_working_style": {"What I built": 0.15}}

# Multi-category quality rules (JSON format)
# - Validates answers contain expected tokens for specific routing categories.
# - JSON keys are RoutingCategory values (snake_case), NOT CardCategory values.
# - min_tokens: list of required tokens (at least min_token_count must be present)
# - v1: LOG-ONLY mode (no retry trigger)
MULTI_CATEGORY_QUALITY_RULES={"education_and_formal_background": {"min_tokens": ["PhD", "M.Sc", "Master", "degree", "university", "xMBA"], "min_token_count": 1}, "research_and_academic_credibility": {"min_tokens": ["research", "published", "papers", "PhD", "conference", "journal", "60+"], "min_token_count": 1}, "leadership_and_product_strategy": {"min_tokens": ["led", "team", "leadership", "Agile", "Scrum", "roadmap", "delivery"], "min_token_count": 1}, "hands_on_engineering": {"min_tokens": ["C++", "Python", "SQL", "Java", "engineer", "implemented", "built", "developed"], "min_token_count": 1}, "architecture_and_system_design": {"min_tokens": ["architecture", "boundaries", "service", "pipeline", "API", "microservice", "monolith"], "min_token_count": 1}, "ai_and_ml_practice": {"min_tokens": ["AI", "ML", "model", "evaluation", "LLM", "RAG", "anomaly", "detection"], "min_token_count": 1}, "career_fit_and_role_alignment": {"min_tokens": ["senior", "engineer", "R&D", "experience", "years", "role", "leader"], "min_token_count": 1}, "personal_interests_and_working_style": {"min_tokens": ["interests", "hobbies", "personal", "location", "Poland", "Warsaw"], "min_token_count": 1}}

# Multi-category card category conditioning (JSON format)
# - Boosts retrieval for specific card categories based on routing category.
# - JSON keys are RoutingCategory values (snake_case), NOT CardCategory values.
# - boost: list of card_category values to boost during retrieval
# - weight: distance bonus (subtracted from distance) for matching cards (capped at 0.25)
# - This is a SOFT boost, not a hard filter.
MULTI_CATEGORY_CARD_CONDITIONING={"education_and_formal_background": {"boost": ["education"], "weight": 0.15}, "research_and_academic_credibility": {"boost": ["research"], "weight": 0.15}, "hands_on_engineering": {"boost": ["project"], "weight": 0.10}, "architecture_and_system_design": {"boost": ["project"], "weight": 0.10}, "ai_and_ml_practice": {"boost": ["project", "research"], "weight": 0.10}}

# Privacy-first interaction logging (required)
# Use a secret unique per deployment.
IP_HASH_SALT=change-me

# Store the LLM conversation context window (last ~6 messages) in `interaction_logs.llm_context_messages`.
# - This may contain user-provided text; disable if you prefer not to persist it.
INTERACTION_LOG_INCLUDE_LLM_CONTEXT=true

# Honor X-Forwarded-For ONLY when the immediate peer is within these CIDRs.
# Example for local reverse proxy:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXY_CIDRS=

# Optional geo-IP lookup (default OFF)
GEOIP_ENABLED=false
GEOIP_PROVIDER=ipapi_co
# Optional override; supports {ip} placeholder
GEOIP_URL=
