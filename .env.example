# Frontend
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
APP_ENV=dev
DATABASE_URL=postgresql://postgres:postgres@db:5432/ask_piotr
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536
ROUTER_MODEL=gpt-4.1-mini
SYNTHESIS_MODEL=gpt-4o-mini
SYNTHESIS_TEMPERATURE=0.1
PROMPT_CACHE_ENABLED=true
OPENAI_API_KEY=sk-...

# OpenAI client behavior (defaults are safe for local dev)
OPENAI_TIMEOUT_S=60
OPENAI_MAX_RETRIES=2

# Startup automation (backend container entrypoint)
# - If enabled, backend will apply SQL migrations and ensure the knowledge base is ingested
#   on every container start.
AUTO_MIGRATE_ENABLED=true
AUTO_INGEST_ENABLED=true
# If true, backend will refuse to start if migrate/ingest fails.
AUTO_STARTUP_FAIL_FAST=true

# Database (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ask_piotr
PGDATA=/var/lib/postgresql/data/pgdata

# Retrieval
# - Controls max number of chunks returned from a single card during the capped
#   diversification passes.
RETRIEVAL_PER_CARD_CAP=2

# Retrieval cutoffs (cosine distance)
# - Lower distance = more similar.
# - Set to "off" to disable.
RETRIEVAL_MAX_DISTANCE=0.90
RETRIEVAL_DISTANCE_DELTA=0.25

# Multi-category routing + per-category retrieval (flag-gated)
#
# When enabled, routing runs on the original user question and returns multiple
# categories with per-category budgets. Retrieval is then performed per category
# and merged/deduped with coverage-aware capping.
MULTI_CATEGORY_RETRIEVAL_ENABLED=false
# Stable request-id based rollout (0-100). Effective only when enabled.
MULTI_CATEGORY_ROLLOUT_PERCENT=0
MULTI_CATEGORY_MAX_CATEGORIES=2
MULTI_CATEGORY_MAX_TOTAL_CHUNKS=5
MULTI_CATEGORY_ALLOW_SIX_CHUNKS=false
# Budget policy version. Currently only "deterministic" is supported.
MULTI_CATEGORY_BUDGET_POLICY=deterministic

# Multi-category pinning rules (JSON format)
# - Ensures specific cards are always included when certain categories are routed.
# - Map category names to lists of card IDs to pin.
# - Example: {"Education and formal background": ["education-facts"]}
#MULTI_CATEGORY_PINNING_RULES={"Education and formal background": ["education-facts"]}

# Multi-category section weights (JSON format)
# - Boosts specific sections during retrieval for certain categories.
# - Weights are positive values that BOOST section ranking (subtract from distance).
# - Formula: adjusted_distance = distance + penalty - bonus
# - Maximum bonus is capped at 0.25 to prevent weak chunks from jumping strong ones.
# - Example: {"Education and formal background": {"degrees": 0.15, "education": 0.12}}
#MULTI_CATEGORY_SECTION_WEIGHTS={"Education and formal background": {"degrees": 0.15}}

# Web security / cross-origin
# - For local dev over HTTP keep COOKIE_SECURE=false.
# - In production behind HTTPS set COOKIE_SECURE=true.
COOKIE_SECURE=false
# Comma-separated list of allowed origins.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Privacy-first interaction logging
# - IP_HASH_SALT should be a secret unique per deployment.
IP_HASH_SALT=change-me

# Store the LLM conversation context window (last ~6 messages) in `interaction_logs.llm_context_messages`.
# - This may contain user-provided text; disable if you prefer not to persist it.
INTERACTION_LOG_INCLUDE_LLM_CONTEXT=true

# Honor X-Forwarded-For ONLY when the immediate peer is within these CIDRs.
# Example for local reverse proxy:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXY_CIDRS=

# Optional geo-IP lookup (default OFF)
GEOIP_ENABLED=false
GEOIP_PROVIDER=ipapi_co
# Optional override; supports {ip} placeholder
GEOIP_URL=
