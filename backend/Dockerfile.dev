# Purpose:
# Backend container image for the Ask-Piotr RAG service.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000

WORKDIR /app

# Minimal runtime deps (certs for https calls e.g. OpenAI)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install deps first for better caching
COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

# Copy code (in dev you'll usually override this with a volume mount)
COPY . .

# Startup hook (migrations + knowledge ingest) before starting the server
RUN chmod +x /app/entrypoint.sh

EXPOSE 8000

# FastAPI dev server
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
